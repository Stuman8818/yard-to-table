generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  CONTACTED
  CONSULTATION_SCHEDULED
  CONSULTATION_COMPLETED
  ESTIMATE_SENT
  CONVERTED
  LOST
}

enum ServiceType {
  LAWN_CARE
  GARDEN_CONSULTATION
  GARDEN_DESIGN
  GARDEN_INSTALLATION
  RAISED_BED_INSTALLATION
  GARDEN_MAINTENANCE
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  CREW
}

enum ConsultationStatus {
  SCHEDULED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum ConsultationType {
  ON_SITE
  PHONE
}

enum ConsultationOutcome {
  ASSESSMENT_NEEDED
  READY_FOR_ESTIMATE
  FOLLOW_UP_NEEDED
  NOT_A_GOOD_FIT
  CUSTOMER_NOT_INTERESTED
}

model Lead {
  id                     String      @id @default(cuid())
  firstName              String
  lastName               String
  email                  String
  phone                  String?
  addressLine1           String
  addressLine2           String?
  city                   String
  state                  String
  postalCode             String
  preferredContactMethod String?
  status                 LeadStatus  @default(NEW)
  statusBeforeConversion LeadStatus?
  notes                  String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  organizationId         String

  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  internalNotes     LeadNote[]
  requestedServices LeadService[]
  convertedCustomer Customer?      @relation("LeadConversion")
  properties        Property[]
  consultations     Consultation[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads         Lead[]
  memberships   OrganizationMembership[]
  customers     Customer[]
  properties    Property[]
  consultations Consultation[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships            OrganizationMembership[]
  leadNotes              LeadNote[]
  consultationsCreated   Consultation[]
  consultationsAssigned  Consultation[]           @relation("ConsultationAssignee")
  consultationsCompleted Consultation[]           @relation("ConsultationCompleter")
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model LeadService {
  id          String      @id @default(cuid())
  leadId      String
  serviceType ServiceType

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, serviceType])
  @@index([leadId])
}

model LeadNote {
  id           String   @id @default(cuid())
  leadId       String
  authorUserId String
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@index([authorUserId])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  sourceLeadId   String?  @unique
  firstName      String
  lastName       String
  email          String
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceLead    Lead?          @relation("LeadConversion", fields: [sourceLeadId, organizationId], references: [id, organizationId], onDelete: Restrict)
  properties    Property[]
  consultations Consultation[]

  @@unique([id, organizationId])
  @@unique([sourceLeadId, organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, email])
}

model Property {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String?
  leadId         String?
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  postalCode     String
  accessNotes    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer      Customer?      @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  lead          Lead?          @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Restrict)
  consultations Consultation[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([customerId])
}

model Consultation {
  id                String               @id @default(cuid())
  organizationId    String
  leadId            String?
  customerId        String?
  propertyId        String?
  assignedUserId    String?
  completedByUserId String?
  type              ConsultationType     @default(ON_SITE)
  scheduledStart    DateTime
  scheduledEnd      DateTime
  status            ConsultationStatus   @default(SCHEDULED)
  notes             String?
  completedAt       DateTime?
  completionNotes   String?
  actualDuration    Int?
  outcome           ConsultationOutcome?
  createdByUserId   String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lead         Lead?        @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Restrict)
  customer     Customer?    @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  property     Property?    @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy    User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignedUser User?        @relation("ConsultationAssignee", fields: [assignedUserId], references: [id], onDelete: Restrict)
  completedBy  User?        @relation("ConsultationCompleter", fields: [completedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, scheduledStart])
  @@index([customerId, scheduledStart])
  @@index([propertyId, scheduledStart])
  @@index([createdByUserId])
  @@index([leadId, scheduledStart])
  @@index([assignedUserId])
  @@index([completedByUserId])
}
