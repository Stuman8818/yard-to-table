{
  "name": "yard-to-table-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:trellis",
    "dev:trellis": "npm run dev --workspace=@yard-to-table/trellis",
    "dev:ytt": "npm run dev --workspace=@yard-to-table/marketing",
    "build": "npm run build --workspaces --if-present",
    "build:trellis": "npm run build --workspace=@yard-to-table/trellis",
    "build:ytt": "npm run build --workspace=@yard-to-table/marketing",
    "start": "npm run start --workspace=@yard-to-table/trellis",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@yard-to-table/trellis",
    "test:watch": "npm run test:watch --workspace=@yard-to-table/trellis",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate --workspace=@yard-to-table/trellis",
    "db:validate": "npm run db:validate --workspace=@yard-to-table/trellis",
    "db:migrate": "npm run db:migrate --workspace=@yard-to-table/trellis",
    "db:deploy": "npm run db:deploy --workspace=@yard-to-table/trellis",
    "db:seed": "npm run db:seed --workspace=@yard-to-table/trellis",
    "db:studio": "npm run db:studio --workspace=@yard-to-table/trellis",
    "db:test": "npm run db:test --workspace=@yard-to-table/trellis",
    "graphql:codegen": "npm run graphql:codegen --workspace=@yard-to-table/trellis",
    "postinstall": "npm run db:generate --workspace=@yard-to-table/trellis"
  },
  "devDependencies": {
    "prettier": "3.9.4"
  }
}
